{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alloy",
  "version": "0.1.1",
  "identifier": "chat.alloy",
  "build": {
    "beforeDevCommand": "pnpm --prefix ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --prefix ui build",
    "frontendDist": "../ui/build"
  },
  "app": {
    "windows": [
      {
        "title": "Alloy",
        "width": 1200,
        "height": 800,
        "minWidth": 680,
        "minHeight": 600
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; base-uri 'none'; form-action 'none'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/media_cache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4REQzQjM0RkYxRjk3RUYKUldUdmx4Ly9ORHZkT01OWXB4bi9nN2ZwS1V4SElERkMzWFFQbE1maXIzcWc4R3dQNm1jT1FaNVIK",
      "endpoints": [
        "https://github.com/centopw/alloy/releases/download/updater-feed/latest.json"
      ]
    }
  }
}
