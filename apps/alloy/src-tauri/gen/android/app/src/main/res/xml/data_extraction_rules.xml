<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ data extraction rules. Alloy keeps session secrets, account
     state and the media cache in app-private storage; none of it may leave
     the device through cloud backup or device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
