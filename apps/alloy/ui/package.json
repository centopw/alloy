{
  "name": "alloy-ui",
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "gen:themes": "cargo run -p alloy-theme --bin gen-css",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/svelte": "^1.58.0",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "dompurify": "^3.4.17",
    "emojibase-data": "^18.0.0",
    "virtua": "^0.53.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.2.7",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^25.14.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.4"
  }
}
