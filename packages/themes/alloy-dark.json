{
  "$schema": "https://alloy.chat/schemas/v1/theme.json",
  "schema_version": 1,
  "id": "alloy-dark",
  "name": "Alloy Dark",
  "author": "Alloy Team",
  "version": "0.1.0",
  "mode": "dark",
  "tokens": {
    "color": {
      "surface": {
        "canvas": "#0e1015",
        "subtle": "#151821",
        "panel": "#151821",
        "elevated": "#1c202d",
        "hover": "#1a1e2b",
        "active": "#252a3a"
      },
      "background": "#0e1015",
      "text": {
        "primary": "#f1f5f9",
        "secondary": "#94a3b8",
        "muted": "#64748b",
        "link": "#60a5fa",
        "on_accent": "#ffffff"
      },
      "accent": {
        "primary": "#3b82f6",
        "secondary": "#818cf8",
        "subtle": "#152137",
        "hover": "#1d4ed8",
        "fill": "#2563eb"
      },
      "status": {
        "online": "#10b981",
        "away": "#f59e0b",
        "busy": "#ef4444",
        "offline": "#64748b",
        "error": "#ef4444",
        "warning": "#f59e0b",
        "info": "#3b82f6",
        "success": "#10b981",
        "mention": "#3b82f6"
      },
      "bubble": {
        "own": {
          "background": "#1d4ed8",
          "text": "#ffffff"
        },
        "other": {
          "background": "#1c202d",
          "text": "#f1f5f9"
        }
      },
      "border": {
        "subtle": "#232734",
        "prominent": "#333a4d",
        "floating": "#2e3446"
      },
      "scrim": "#05070ab3",
      "user": {
        "1": "#f87171",
        "2": "#fb923c",
        "3": "#fbbf24",
        "4": "#4ade80",
        "5": "#2dd4bf",
        "6": "#38bdf8",
        "7": "#60a5fa",
        "8": "#818cf8",
        "9": "#a78bfa",
        "10": "#e879f9",
        "11": "#fb7185",
        "12": "#22d3ee"
      }
    },
    "typography": {
      "font_family": {
        "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "mono": "'JetBrains Mono', 'Fira Code', monospace",
        "display": "Inter, -apple-system, BlinkMacSystemFont, sans-serif"
      },
      "size": {
        "xs": "11px",
        "sm": "12px",
        "base": "14px",
        "lg": "16px",
        "xl": "18px",
        "xxl": "24px"
      },
      "weight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      },
      "line_height": {
        "tight": "1.25",
        "normal": "1.5",
        "relaxed": "1.75"
      }
    },
    "spacing": {
      "density": "normal",
      "presets": {
        "compact": {
          "message_padding": "4px",
          "avatar_size": "28px",
          "item_gap": "4px"
        },
        "normal": {
          "message_padding": "8px",
          "avatar_size": "36px",
          "item_gap": "8px"
        },
        "cozy": {
          "message_padding": "12px",
          "avatar_size": "40px",
          "item_gap": "12px"
        }
      },
      "scale": {
        "1": "4px",
        "2": "8px",
        "3": "12px",
        "4": "16px",
        "6": "24px",
        "8": "32px"
      },
      "message_padding": "8px",
      "avatar_size": "36px"
    },
    "radii": {
      "none": "0px",
      "sm": "4px",
      "md": "6px",
      "lg": "8px",
      "full": "9999px"
    },
    "elevation": {
      "none": "none",
      "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.4)",
      "md": "0 8px 24px -4px rgba(0, 0, 0, 0.6)",
      "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.6), 0 4px 6px -4px rgba(0, 0, 0, 0.6)"
    },
    "motion": {
      "duration": {
        "fast": "100ms",
        "normal": "200ms",
        "slow": "350ms"
      },
      "easing": {
        "ease": "ease",
        "ease_in_out": "cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "reduced_motion": false
    },
    "layout": {
      "message_style": "bubble",
      "avatar_shape": "circle"
    },
    "chat": {
      "background": {
        "kind": "none",
        "value": "none",
        "opacity": "1"
      }
    }
  }
}
