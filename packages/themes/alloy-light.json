{
  "$schema": "https://alloy.chat/schemas/v1/theme.json",
  "schema_version": 1,
  "id": "alloy-light",
  "name": "Alloy Light",
  "author": "Alloy Team",
  "version": "0.1.0",
  "mode": "light",
  "tokens": {
    "color": {
      "surface": {
        "canvas": "#f2f4f7",
        "subtle": "#eaeef3",
        "panel": "#fbfcfd",
        "elevated": "#ffffff",
        "hover": "#e4e9ee",
        "active": "#d8dee6"
      },
      "background": "#f2f4f7",
      "text": {
        "primary": "#18181b",
        "secondary": "#52525b",
        "muted": "#65656d",
        "link": "#2563eb",
        "on_accent": "#ffffff"
      },
      "accent": {
        "primary": "#4f46e5",
        "secondary": "#6366f1",
        "subtle": "#e0e7ff",
        "hover": "#4338ca",
        "fill": "#4f46e5"
      },
      "status": {
        "online": "#16a34a",
        "away": "#d97706",
        "busy": "#dc2626",
        "offline": "#71717a",
        "error": "#dc2626",
        "warning": "#d97706",
        "info": "#2563eb",
        "success": "#16a34a",
        "mention": "#ea580c"
      },
      "bubble": {
        "own": {
          "background": "#4f46e5",
          "text": "#ffffff"
        },
        "other": {
          "background": "#f4f4f5",
          "text": "#18181b"
        }
      },
      "border": {
        "subtle": "#e4e4e7",
        "prominent": "#d4d4d8",
        "floating": "#d4d4d8"
      },
      "scrim": "#05070ab3",
      "user": {
        "1": "#b91c1c",
        "2": "#c2410c",
        "3": "#b45309",
        "4": "#15803d",
        "5": "#0f766e",
        "6": "#0369a1",
        "7": "#1d4ed8",
        "8": "#4338ca",
        "9": "#6d28d9",
        "10": "#a21caf",
        "11": "#be123c",
        "12": "#0e7490"
      }
    },
    "typography": {
      "font_family": {
        "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "mono": "'JetBrains Mono', 'Fira Code', monospace",
        "display": "Inter, -apple-system, BlinkMacSystemFont, sans-serif"
      },
      "size": {
        "xs": "11px",
        "sm": "12px",
        "base": "14px",
        "lg": "16px",
        "xl": "18px",
        "xxl": "24px"
      },
      "weight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      },
      "line_height": {
        "tight": "1.25",
        "normal": "1.5",
        "relaxed": "1.75"
      }
    },
    "spacing": {
      "density": "normal",
      "presets": {
        "compact": {
          "message_padding": "4px",
          "avatar_size": "28px",
          "item_gap": "4px"
        },
        "normal": {
          "message_padding": "8px",
          "avatar_size": "36px",
          "item_gap": "8px"
        },
        "cozy": {
          "message_padding": "12px",
          "avatar_size": "40px",
          "item_gap": "12px"
        }
      },
      "scale": {
        "1": "4px",
        "2": "8px",
        "3": "12px",
        "4": "16px",
        "5": "20px",
        "6": "24px",
        "7": "32px",
        "8": "40px"
      },
      "message_padding": "8px",
      "avatar_size": "36px"
    },
    "radii": {
      "none": "0px",
      "sm": "4px",
      "md": "6px",
      "lg": "8px",
      "xl": "12px",
      "2xl": "16px",
      "full": "9999px"
    },
    "elevation": {
      "none": "none",
      "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
      "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)"
    },
    "motion": {
      "duration": {
        "fast": "100ms",
        "normal": "200ms",
        "slow": "350ms"
      },
      "easing": {
        "ease": "ease",
        "ease_in_out": "cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "reduced_motion": false
    },
    "layout": {
      "message_style": "bubble",
      "avatar_shape": "circle"
    },
    "chat": {
      "background": {
        "kind": "none",
        "value": "none",
        "opacity": "1"
      }
    }
  }
}
